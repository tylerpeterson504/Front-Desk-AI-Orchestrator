# Dashboard Dockerfile (local development)
FROM node:20-alpine

WORKDIR /app/dashboard

# Install dependencies first so Docker can cache this layer
COPY dashboard/package*.json ./
RUN npm install

# Copy the rest of the dashboard (paths match the ./dashboard:/app/dashboard
# volume mount in docker-compose.yml)
COPY dashboard/ ./

EXPOSE 5173

# Dev server with hot reload; do not use for production
CMD ["npm", "run", "dev"]
