{
  "name": "front-desk-ai-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Front Desk AI Orchestrator: backend API + Vite dashboard + Chrome extension",
  "scripts": {
    "build": "npm run build:backend && npm run build:dashboard",
    "build:all": "npm run build:backend && npm run build:dashboard",
    "build:backend": "cd backend && npm run build",
    "build:dashboard": "cd dashboard && npm run build",
    "dev:backend": "cd backend && npm run dev",
    "dev:dashboard": "cd dashboard && npm run dev",
    "test": "npm run test:backend && npm run test:dashboard",
    "test:all": "npm run test:backend && npm run test:dashboard",
    "test:backend": "cd backend && npm test",
    "test:dashboard": "cd dashboard && npm test",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck:backend && npm run typecheck:dashboard",
    "typecheck:backend": "cd backend && node node_modules/typescript/bin/tsc --noEmit --project tsconfig.json",
    "typecheck:dashboard": "cd dashboard && node node_modules/typescript/bin/tsc --noEmit --project tsconfig.json",
    "clean": "rm -rf node_modules backend/dist dashboard/dist",
    "clean:all": "rm -rf node_modules backend/node_modules dashboard/node_modules backend/dist dashboard/dist",
    "prepare": "husky install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:dashboard\"",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck:extension": "cd extension && npm run typecheck",
    "typecheck:all": "npm run typecheck:backend && npm run typecheck:dashboard && npm run typecheck:extension"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2"
  },
  "engines": {
    "node": ">=24"
  }
}
