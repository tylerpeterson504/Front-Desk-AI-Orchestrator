{
  "name": "front-desk-ai-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Front Desk AI Orchestrator - Backend API + Vite Dashboard + Chrome Extension",
  "main": "dist/backend/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:backend && npm run build:dashboard",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:dashboard": "tsc -p dashboard/tsconfig.json && vite build --config dashboard/vite.config.ts",
    "build:extension": "vite build --config extension/vite.config.ts",
    "start": "node dist/backend/index.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:dashboard\"",
    "dev:backend": "ts-node-dev --respawn --transpile-only backend/src/index.ts",
    "dev:dashboard": "vite --config dashboard/vite.config.ts",
    "test": "npm run test:backend",
    "test:backend": "jest --config backend/jest.config.js",
    "test:dashboard": "vitest run --config dashboard/vitest.config.ts",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p dashboard/tsconfig.json",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist node_modules backend/dist dashboard/build extension/dist",
    "prepare": "husky install"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1",
    "winston": "^3.13.1",
    "zod": "^3.23.8",
    "@headlessui/react": "^2.0.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.49.2",
    "axios": "^1.7.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "@hookform/resolvers": "^3.3.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^5.3.3",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.0",
    "jsdom": "^25.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/chrome": "^0.0.254"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/backend/tests/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "setupFiles": [
      "<rootDir>/backend/tests/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/backend/src/$1",
      "^@config/(.*)$": "<rootDir>/backend/src/config/$1",
      "^@routes/(.*)$": "<rootDir>/backend/src/routes/$1",
      "^@services/(.*)$": "<rootDir>/backend/src/services/$1",
      "^@lib/(.*)$": "<rootDir>/backend/src/lib/$1",
      "^@middleware/(.*)$": "<rootDir>/backend/src/middleware/$1",
      "^@entities/(.*)$": "<rootDir>/backend/src/entities/$1"
    },
    "transform": {
      "^.+\\\\.(ts|js)$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              6133,
              151002
            ]
          },
          "tsconfig": "backend/tsconfig.test.json"
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}