# Backend Environment Variables - Production
# REPLACE ALL PLACEHOLDER VALUES BEFORE USING IN PRODUCTION

NODE_ENV=production
PORT=3001

# Database Configuration (Neon or self-hosted PostgreSQL)
# Option 1: Connection string
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME?sslmode=require

# Option 2: Individual settings
DB_HOST=YOUR_DB_HOST
DB_PORT=5432
DB_NAME=YOUR_DB_NAME
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

# Authentication Configuration - REGENERATE FOR PRODUCTION
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=YOUR_32_PLUS_CHARACTER_RANDOM_STRING_HERE
JWT_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Registration Configuration - RECOMMENDED: invite mode for production
REGISTRATION_MODE=invite
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
REGISTRATION_INVITE_TOKEN=YOUR_LONG_RANDOM_INVITE_TOKEN_HERE

# Encryption Key for WiFi password (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WIFI_ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_STRING_HERE

# CORS Configuration - Set your production domains
CORS_ORIGIN=https://your-dashboard-domain.com,chrome-extension://your_extension_id

# Seeding - Set to false in production after initial seed
RUN_SEEDS=false

# AI Configuration
# Get from: https://console.mistral.ai/
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY

# S3 Storage (Neon or AWS)
AWS_ENDPOINT_URL_S3=YOUR_S3_ENDPOINT
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_REGION=YOUR_AWS_REGION

# AI Gateway (Neon)
NEON_AI_GATEWAY_TOKEN=YOUR_NEON_AI_GATEWAY_TOKEN

# Server Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
