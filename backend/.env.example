# Backend Environment Variables
NODE_ENV=development
PORT=3001

# Database (use individual vars OR DATABASE_URL)
# For Docker: DB_HOST=db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=frontdesk_ai
DB_USER=frontdesk_user
DB_PASSWORD=frontdesk_pass

# Authentication
JWT_SECRET=your_jwt_secret_change_in_production
# Access-token lifetime. Deliberately short: access tokens are stateless, so
# expiry is the only thing that bounds a stolen or de-privileged one. Clients
# refresh silently, so raising this buys nothing but risk.
JWT_TTL=15m
# Refresh-token (session) lifetime in days. 1-365; anything else falls back to 30.
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Registration policy: invite | open | closed
# Unset defaults to `invite` in production and `open` everywhere else.
# `invite` requires the token below, sent as X-Registration-Token.
REGISTRATION_MODE=open
# REGISTRATION_INVITE_TOKEN=generate_a_long_random_string

# Encryption key for properties.wifi_password (AES-256-GCM).
# 32 bytes, base64 or hex. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WIFI_ENCRYPTION_KEY=

# Comma-separated allowed browser origins. Required in production.
# CORS_ORIGIN=https://dashboard.example.com,chrome-extension://hmjpbhiploiaghgnolmlenledgmecblk

# Seeding
RUN_SEEDS=true

# AI Configuration (Mistral)
# Get API key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key
# Model options: mistral-tiny, mistral-small, mistral-medium, mistral-large
MISTRAL_MODEL=mistral-medium
MISTRAL_BASE_URL=https://api.mistral.ai

# Databricks Configuration
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_personal_access_token
DATABRICKS_WORKSPACE_ID=your_workspace_id
DATABRICKS_WAREHOUSE_ID=your_warehouse_id

# GitHub Configuration
GITHUB_REPOSITORY=your_org/your_repo
GITHUB_TOKEN=your_github_personal_access_token

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@front-desk-ai.com

# Email Configuration (SendGrid - alternative)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@front-desk-ai.com
REPLY_TO_EMAIL=support@front-desk-ai.com

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_DEFAULT_CHANNEL=#general
SLACK_ESCALATION_CHANNEL=#escalations
SLACK_ERROR_CHANNEL=#errors
SLACK_SHIFT_CHANNEL=#shift-handovers
SLACK_SIGNING_SECRET=your_signing_secret

# Webhook Configuration
# JSON array of webhook configurations
# WEBHOOK_URLS=[{"id":"webhook1","name":"My Webhook","url":"https://example.com/webhook","secret":"optional_secret","events":["*"]}]

# i18n Configuration
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,nl
DEFAULT_LANGUAGE=en
