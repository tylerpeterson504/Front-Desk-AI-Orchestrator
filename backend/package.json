{
  "name": "front-desk-ai-backend",
  "version": "1.0.0",
  "description": "Backend API for Front Desk AI Orchestrator",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "ts-node-dev src/index.ts",
    "migrate": "node dist/db/migrate.js",
    "seed": "node db/seed-runner.js",
    "db-setup": "node db/db-setup.js",
    "encrypt-wifi": "node db/encrypt-wifi.js",
    "set-role": "node db/set-role.js",
    "prune-sessions": "node db/prune-sessions.js",
    "test": "jest --runInBand --forceExit",
    "test:api": "jest tests/api.test.ts",
    "test:security": "jest tests/security.test.ts",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --ext .js,.ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg-promise": "^11.9.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1",
    "winston": "^3.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}

