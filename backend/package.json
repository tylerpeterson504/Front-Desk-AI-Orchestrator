{
  "name": "front-desk-ai-backend",
  "version": "1.0.0",
  "description": "Backend API for Front Desk AI Orchestrator",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed-runner.js",
    "db-setup": "node db/db-setup.js",
    "test": "jest --runInBand",
    "test:auth": "jest tests/auth.test.js",
    "test:properties": "jest tests/properties.test.js",
    "test:templates": "jest tests/templates.test.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "pg-promise": "^11.9.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
