# Backend Dockerfile (local development)
FROM node:20-alpine

WORKDIR /app/backend

# Install dependencies first so Docker can cache this layer
COPY backend/package*.json ./
RUN npm install

# Copy source files (paths match the ./backend:/app/backend volume mount
# in docker-compose.yml)
COPY backend/src ./src
COPY backend/tsconfig.json ./
COPY backend/.env.example ./

RUN mkdir -p tmp

EXPOSE 3001

# Dev server with hot reload; do not use for production
CMD ["npm", "run", "dev"]
