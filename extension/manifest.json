{
  "manifest_version": 3,
  "name": "Front Desk AI",
  "version": "1.0.0",
  "description": "AI copilot for hotel front desk agents",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "https://app.us1.stayntouch.com/*",
    "https://sys.akia.ai/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.us1.stayntouch.com/*"
      ],
      "js": [
        "src/config.ts",
        "src/content-stayntouch.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sys.akia.ai/*"
      ],
      "js": [
        "src/config.ts",
        "src/content-akia.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}