{
  "root": true,
  "env": {
    "node": true,
    "es2022": true,
    "browser": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:prettier/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": [
    "@typescript-eslint",
    "react",
    "react-hooks",
    "prettier"
  ],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "off",
    "@typescript-eslint/prefer-nullish-coalescing": "off",
    "@typescript-eslint/prefer-optional-chain": "off",
    "@typescript-eslint/no-floating-promises": "off",
    "@typescript-eslint/no-misused-promises": "off",
    "@typescript-eslint/await-thenable": "off",
    "@typescript-eslint/require-await": "off",
    "react/prop-types": "off",
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "prettier/prettier": "off",
    "no-console": "warn",
    "no-debugger": "warn",
    "no-var": "error",
    "prefer-const": "off",
    "prefer-arrow-callback": "off",
    "no-restricted-imports": "off",
    "no-empty": "off",
    "@typescript-eslint/prefer-as-const": "off",
    "@typescript-eslint/no-empty-object-type": "off",
    "no-useless-escape": "off",
    "@typescript-eslint/no-unused-expressions": "off"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.test.js",
        "**/*.spec.js"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-floating-promises": "off",
        "@typescript-eslint/no-require-imports": "off",
        "no-undef": "off",
        "no-empty": "off",
        "@typescript-eslint/prefer-as-const": "off",
        "@typescript-eslint/no-empty-object-type": "off",
        "@typescript-eslint/ban-ts-comment": "off",
        "no-useless-escape": "off",
        "@typescript-eslint/no-unused-expressions": "off",
        "prefer-const": "off"
      },
      "env": {
        "jest": true,
        "node": true,
        "browser": true
      },
      "globals": {
        "describe": "readonly",
        "it": "readonly",
        "expect": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly",
        "beforeAll": "readonly",
        "afterAll": "readonly",
        "jest": "readonly",
        "chrome": "readonly"
      }
    },
    {
      "files": [
        "**/tests/**/*.js",
        "**/tests/**/*.ts",
        "**/tests/**/*.tsx"
      ],
      "rules": {
        "no-undef": "off",
        "no-empty": "off",
        "@typescript-eslint/prefer-as-const": "off",
        "@typescript-eslint/no-empty-object-type": "off",
        "@typescript-eslint/ban-ts-comment": "off",
        "no-useless-escape": "off",
        "@typescript-eslint/no-unused-expressions": "off",
        "prefer-const": "off"
      },
      "env": {
        "jest": true,
        "node": true,
        "browser": true
      },
      "globals": {
        "describe": "readonly",
        "it": "readonly",
        "expect": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly",
        "beforeAll": "readonly",
        "afterAll": "readonly",
        "jest": "readonly",
        "chrome": "readonly"
      }
    },
    {
      "files": [
        "**/backend/**/*.ts"
      ],
      "rules": {
        "@typescript-eslint/no-var-requires": "off"
      }
    },
    {
      "files": [
        "**/backend/**/*.js"
      ],
      "rules": {
        "@typescript-eslint/no-var-requires": "off",
        "@typescript-eslint/no-require-imports": "off"
      }
    },
    {
      "files": [
        "vite.config.ts",
        "vite.config.js"
      ],
      "rules": {
        "@typescript-eslint/no-var-requires": "off",
        "@typescript-eslint/no-require-imports": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".git",
    "*.config.js",
    "*.config.ts"
  ]
}
